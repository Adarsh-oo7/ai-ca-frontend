# Study Commander AI — Frontend Environment Variables (Vercel)

# The base URL of your Django backend REST API hosted on your VPS.
# Used as a fallback. Production prefers server-only BACKEND_API_URL + /backend proxy.
NEXT_PUBLIC_API_URL=https://api-study.digitalproductsolutions.in

# Live Talk WebSocket (Gemini Live proxy on the VPS). Next.js cannot proxy WebSockets.
NEXT_PUBLIC_WS_URL=wss://api-study.digitalproductsolutions.in/ws/gemini-live/

